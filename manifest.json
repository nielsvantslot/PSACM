{
    "name": "Cardmarket Grading Scanner",
    "description": "Scan Cardmarket pages for graded card listings (PSA, CGC, BGS, TAG, ACE, MNT, SGC).",
    "version": "2.3",
    "manifest_version": 3,
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Scan for Graded Cards"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.cardmarket.com/*",
                "https://www.cardmarket.com/*/*",
                "https://www.cardmarket.com/*/*/*"
            ],
            "js": ["lib/grading.js", "lib/prices.js", "content.js"]
        }
    ]
}