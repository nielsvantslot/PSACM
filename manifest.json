{
    "name": "Cardmarket Grading Scanner",
    "description": "Scan Cardmarket for graded listings (PSA, CGC, BGS, TAG, ACE, MNT, SGC) with favourites, photo filter, price overview, remember me.",
    "version": "3.0",
    "manifest_version": 3,
    "permissions": [
        "activeTab",
        "storage",
        "cookies",
        "alarms"
    ],
    "host_permissions": [
        "https://www.cardmarket.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Scan for Graded Cards"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.cardmarket.com/*",
                "https://www.cardmarket.com/*/*",
                "https://www.cardmarket.com/*/*/*"
            ],
            "js": [
                "lib/grading.js",
                "lib/prices.js",
                "lib/favorites.js",
                "content.js"
            ]
        },
        {
            "matches": [
                "https://www.cardmarket.com/*",
                "https://www.cardmarket.com/*/*",
                "https://www.cardmarket.com/*/*/*"
            ],
            "js": [
                "lib/auth-state.js",
                "auth.js"
            ],
            "run_at": "document_idle"
        }
    ]
}